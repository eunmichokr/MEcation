---
import '../styles/global.css';
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | 조은미 윔호프 스튜디오</title>
  <meta name="description" content={description} />

  <!-- PWA -->
  <link rel="manifest" href={`${base}manifest.json`} />
  <meta name="theme-color" content="#221E19" />
  <link rel="apple-touch-icon" href={`${base}icons/icon-192.png`} />
</head>
<body>
  <nav class="site-nav">
    <a class="brand" href={`${base}`}>조은미 · 숨결</a>
    <ul>
      <li><a href={`${base}about`}>소개</a></li>
      <li><a href={`${base}programs`}>프로그램</a></li>
      <li><a href={`${base}booking`}>예약</a></li>
      <li><a href={`${base}reviews`}>후기</a></li>
      <li><a href={`${base}blog`}>블로그</a></li>
    </ul>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    <div class="wrap">
      <p>조은미 · Wim Hof Method Certified Instructor · 서울</p>
      <p>&copy; {new Date().getFullYear()} 숨결 스튜디오. All rights reserved.</p>
    </div>
  </footer>

  <script>
    if ('serviceWorker' in navigator) {
      const base = document.querySelector('link[rel="manifest"]').getAttribute('href').replace('manifest.json', '');
      navigator.serviceWorker.register(`${base}sw.js`).catch(() => {});
    }
  </script>
</body>
</html>
